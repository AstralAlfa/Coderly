// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
    IDEA
    IN_PROGRESS
    DONE
}

enum ContactRequestStatus {
    PENDING
    ACCEPTED
    DECLINED
}

model User {
    id                         String           @id @default(uuid())
    email                      String           @unique
    password                   String 
    username                   String           @unique
    bio                        String?
    githubUrl                  String?
    isVerified                 Boolean          @default(false)
    verificationToken          String?          @unique
    verificationTokenExpiresAt DateTime?
    createdAt                  DateTime         @default(now())
    updatedAt                  DateTime         @updatedAt
    phone                      String?
    telegramUsername           String?

    projects                   Project[]
    sentRequest                ContactRequest[] @relation("SentRequest")
    receivedRequests           ContactRequest[] @relation("ReceivedRequests")
}

model ContactRequest {
    id          String               @id @default(uuid())
    status      ContactRequestStatus @default(PENDING)
    createdAt   DateTime             @default(now())
    updatedAt   DateTime             @updatedAt

    requester   User                 @relation("SentRequest", fields: [requesterId], references: [id])
    requesterId String

    recipient   User                 @relation("ReceivedRequests", fields: [recipientId], references: [id])
    recipientId String

    @@unique([requesterId, recipientId])
}

model Project {
    id          String        @id @default(uuid())
    title       String
    description String
    status      ProjectStatus @default(IDEA)
    githubUrl   String?
    demoUrl     String?
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt

    owner       User          @relation(fields: [ownerId], references: [id])
    ownerId     String

    tags        Tag[]         @relation("ProjectTags")
}

model Tag {
    id       String    @id @default(uuid())
    name     String    @unique

    projects Project[] @relation("ProjectTags")
}
